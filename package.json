{
  "name": "frontend-engineering-system",
  "version": "0.0.0",
  "private": true,
  "description": "一个从零开始构建的前端工程实践项目。",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "build:staging": "pnpm --filter web build:staging",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "pnpm --filter web preview",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:unit:coverage": "pnpm -r --if-present run test:unit:coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6"
  }
}
